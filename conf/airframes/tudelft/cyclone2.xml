<!DOCTYPE airframe SYSTEM "../airframe.dtd">
<airframe name="Cyclone2">
    <description>
        Cyclone 2 airframe

        + Model:       Cyclone 2 is a flatplate wing with a ~1m wingspan
        + Autopilot:   Cube orange
        + Actuators:   Feetech sts3032
        + GNSS         Ublox F9P GNSS with RTK
        + MAG          ΡΜ3100
        + ESC:         KISS ECSs
        + RCRX:        ELRS RP1
        + AIRSPEED:    MS4525DO
        + TELEMETRY:   RFDesign 868X
        + CURRENT:     Standard FC Power sensor
        + RANGER:      None
        + MOTOR:       2x 1250KV Outrunner Brushless
        + PROP:        2 blade thin electric 8 x 6
        + BAT:         Li-Po 4S1P 2300mAh

        WARNING: Current PPRZ airspeed sensor driver has a bug,
        static and dynamic pressure defaults are swapped,
        so the airspeed is negative if you dont change your pitot leads

        NOTES:
        + Using INDI
        + Servos powered via external BEC (4s to 9 V)
        + Flightcontroller powered via FC Powerboard
        + Telemetry powerd via BEC of FC Powerboard
    </description>

    <firmware name="rotorcraft">

        <!-- <configure name="RTOS_DEBUG" value="1"/>  --> <!-- TODO: Disable or Enable when needed -->
        <configure name="PERIODIC_FREQUENCY" value="500"/>

        <!-- * REAL FC TARGET * -->
        <target name="ap" board="cube_orange">
            
            <define name="ADC_CURUARTRENT_DISABLE" value="TRUE"/>

            <module name="actuators" type="dummy">
                <define name="HAL_USE_PWM" value="FALSE"/>
                <define name="USE_PWM1" value="FALSE"/>
                <define name="USE_PWM2" value="FALSE"/>
                <define name="USE_PWM3" value="FALSE"/>
                <define name="USE_PWM4" value="FALSE"/>
                <define name="USE_PWM5" value="FALSE"/>
                <define name="USE_PWM6" value="FALSE"/>
            </module>

            <module name="airspeed" type="ms45xx_i2c">
                <configure name="MS45XX_I2C_DEV" value="i2c2"/>
                <!-- Gives cut-off freq of 1/(2*pi*tau) in 1Hz -->
                <define name="USE_AIRSPEED_LOWPASS_FILTER" value="FALSE"/>
                <!-- <define name="MS45XX_LOWPASS_TAU" value="0.15"/> -->
                <define name="MS45XX_PRESSURE_RANGE" value="1"/>
                <define name="MS45XX_PRESSURE_OFFSET" value="8222.7"/>
                <define name="MS45XX_PRESSURE_SCALE" value="1.1786"/>
                <define name="USE_AIRSPEED_MS45XX" value="FALSE"/>
                <define name="MS45XX_SYNC_SEND" value="TRUE"/><!-- TODO: Disable after tuning -->
            </module>

            <module name="gps" type="ublox">
                <configure name="GPS_BAUD" value="B460800"/><!-- UBX message only but rate set to ~?HZ with GPS, GLONASS, BEIDU and GALILEIO at the SAME time is a LOT of GNSS message data-->
                <!-- <define name="USE_GPS_UBX_RTCM" value="TRUE"/> -->
                <!-- <configure name="UBX2_GPS_PORT" value="UART9"/> -->
            </module>

            <module name="radio_control" type="sbus">
                    <!-- <configure name="SBUS_PORT" value="UART3"/> -->
                    <define name="RADIO_CONTROL_NB_CHANNEL" value="16"/>
                    <define name="RADIO_KILL_SWITCH" value="RADIO_AUX1"/> <!-- AUXx is defined in elrs.xml file -->
                    <define name="INDI_FUNCTIONS_RC_CHANNEL" value="RADIO_AUX2"/>
            </module>

            <module name="telemetry" type="transparent">
                <!-- <configure name="MODEM_PORT" value="usb_serial"/> -->
                <configure name="MODEM_BAUD" value="B115200"/>
            </module>

            <module name="mag" type="rm3100">
                <configure name="MAG_RM3100_I2C_DEV" value="i2c2"/>
                <!-- <configure name="MAG_RM3100_PERIODIC_FREQUENCY" value="125"/> -->

                <!-- 0:X, 1:Y, 2:Z; -->
                <define name="RM3100_CHAN_X" value="1"/>
                <define name="RM3100_CHAN_Y" value="0"/>
                <define name="RM3100_CHAN_Z" value="2"/>

                <define name="RM3100_CHAN_X_SIGN" value="+"/>
                <define name="RM3100_CHAN_Y_SIGN" value="+"/>
                <define name="RM3100_CHAN_Z_SIGN" value="-"/>

                <define name="MODULE_RM3100_UPDATE_AHRS" value="TRUE"/>
                <!-- <configure name="MODULE_RM3100_SYNC_SEND" value="TRUE"/> -->

                <!--TODO: Set correct angles-->
                <define name="RM3100_MAG_TO_IMU_PHI" value="RadOfDeg\(0.0\)"/>
                <define name="RM3100_MAG_TO_IMU_THETA" value="RadOfDeg\(0.0\)"/>
                <define name="RM3100_MAG_TO_IMU_PSI" value="RadOfDeg\(0.0\)"/>
            </module>

            <module name="serial_act_t4">
                <configure name="SERIAL_ACT_T4_PORT" value="UART8"/>
                <configure name="SERIAL_ACT_T4_BAUD" value="B921600"/>
            </module>

            <module name="flight_recorder"/>

            <module name="imu" type="cube"/>

            <module name="eff_scheduling_cyfoam">
                <define name="SQUARED_ROLL_EFF" value="0.0022"/> <!-- ??? -->
                <define name="PITCH_EFF_AT_60" value="5.5"/>
                <define name="YAW_EFF_AT_60" value="3"/>
                <!--function of the form: A + B*airspeed^2-->
                <define name="CE_PITCH_A" value="3.042"/>
                <define name="CE_PITCH_B" value="0.0444"/>
                <define name="CE_YAW_A" value="-0.5"/>
                <define name="CE_YAW_B" value="0.07"/>
            </module>

            <!-- Use the external mag (not in NPS target as then it needs to listen to all) -->
            <define name="INS_FINV_MAG_ID" value="MAG_RM3100_SENDER_ID"/>
            <define name="INS_EKF2_MAG_ID" value="MAG_RM3100_SENDER_ID"/>
            <define name="AHRS_ICQ_MAG_ID" value="MAG_RM3100_SENDER_ID"/>
        </target> <!-- * REAL FC TARGET * -->

        <!-- * SIM TARGET * -->
        <target name="nps" board="pc">
            
            <module name="fdm" type="jsbsim"/>
            
            <module name="udp"/>
            
            <module name="radio_control" type="datalink"/>
            
            <module name="logger_file">
                <define name="LOGGER_FILE_PATH" value="/home/ntouev/pprz_sim_logs/"/>
            </module>
            
            <define name="INDI_FUNCTIONS_RC_CHANNEL" value="4"/>
        </target> <!-- * SIM TARGET * -->

        <!-- * COMMON stuff * -->
        <define name="BAT_CHECKER_DELAY" value="80"/>
        <define name="CATASTROPHIC_BATTERY_KILL_DELAY" value="410"/>
        <configure name="USE_MAGNETOMETER" value="TRUE"/>

        <module name="overactuated_mixing"/>

        <module name="air_data">
            <define name="USE_AIRSPEED_AIR_DATA" value="TRUE"/>
        </module>

        <module name="geo_mag"/>

        <!-- <module name="ins" type="ekf2">
            <define name="INS_EKF2_MAG_ID" value="MAG_RM3100_SENDER_ID"/>
            <define name="INS_EKF2_ACCEL_ID" value="IMU_CUBE1_ID"/>
            <define name="INS_EKF2_GYRO_ID" value="IMU_CUBE1_ID"/>
            <define name="IMU_GYRO_ABI_SEND_ID"     value= "IMU_CUBE1_ID"/>
            <define name="IMU_ACCEL_ABI_SEND_ID"    value= "IMU_CUBE1_ID"/>
        </module> -->

        <module name="ins" type="extended">
            <define name="IMU_GYRO_ABI_SEND_ID"     value= "IMU_CUBE1_ID"/>
            <define name="IMU_ACCEL_ABI_SEND_ID"    value= "IMU_CUBE1_ID"/>
        </module>

        <module name="ahrs" type="float_cmpl_quat">
            <!-- <define name="AHRS_USE_GPS_HEADING" value="TRUE"/> -->
            <configure name="USE_MAGNETOMETER" value="TRUE"/> <!-- if using INS EKF2 this forced already-->
            <configure name="AHRS_USE_MAGNETOMETER" value="TRUE"/><!-- if using INS EKF2 this forced already-->
            <define name="AHRS_MAG_UPDATE_ALL_AXES" value="FALSE"/>
            <!-- <define name="AHRS_GPS_SPEED_IN_NEGATIVE_Z_DIRECTION" value="FALSE"/>-->
            <!-- <define name="AHRS_HEADING_UPDATE_GPS_MIN_SPEED" value="3.0"/> in unit m/s" -->
            <define name="AHRS_GRAVITY_HEURISTIC_FACTOR" value="0.0"/>
        </module>

        <module name="stabilization" type="indi">
            <define name="INDI_THRUST_ON_PITCH_EFF" value="23.0"/>
            <define name="TILT_TWIST_CTRL" value="TRUE" />
            <define name="WLS_N_U_MAX" value="4" />
            <define name="WLS_N_V_MAX" value="4" />
        </module>

        <module name="guidance" type="indi_hybrid_tailsitter">
            <define name="GUIDANCE_INDI_RC_DEBUG" value="FALSE"/>
            <define name="GUIDANCE_INDI_POS_GAIN" value="0.2"/>
            <define name="GUIDANCE_INDI_SPEED_GAIN" value="1.0"/>
            <define name="GUIDANCE_INDI_POS_GAINZ" value="0.5"/>
            <define name="GUIDANCE_INDI_SPEED_GAINZ" value="1.8"/>
            <define name="GUIDANCE_INDI_LIFTD_ASQ" value="0.20"/>
            <define name="GUIDANCE_INDI_PITCH_EFF_SCALING" value="1.0"/>
            <define name="GUIDANCE_H_REF_MAX_SPEED" value="18.0"/>
            <!--not used-->
            <define name="GUIDANCE_INDI_MIN_THROTTLE" value="3000"/>
            <define name="GUIDANCE_INDI_MIN_THROTTLE_FWD" value="1500"/>
            <define name="GUIDANCE_INDI_MAX_AIRSPEED" value="16.0"/>
            <define name="GUIDANCE_INDI_HEADING_BANK_GAIN" value="15.0"/>
            <define name="GUIDANCE_INDI_SPECIFIC_FORCE_GAIN" value="-500.0"/>
            <define name="GUIDANCE_INDI_THRUST_DYNAMICS_FREQ" value="23.6"/>
        </module>

        <module name="nav" type="hybrid">
            <define name="GUIDANCE_H_USE_REF" value="FALSE"/>
        </module>

        <module name="nav" type="survey_hybrid">
            <define name="SURVEY_HYBRID_MAX_SWEEP_BACK" value="1"/>
            <define name="SURVEY_HYBRID_APPROACHING_TIME" value="0"/>
            <define name="SURVEY_HYBRID_ENTRY_DISTANCE" value="12"/><!--TODO: set survey_private.sweep_distance -->
            <define name="SURVEY_HYBRID_ENTRY_CIRCLE" value="FALSE"/>
        </module>

        <module name="nav" type="takeoff_and_landing"/>

        <module name="traffic_info"/>

        <module name="sys_mon"/>
       
        <!-- <module name="shell">
            <configure name="SHELL_PORT" value="usb_serial_debug"/>
        </module> -->

    </firmware>

    <servos>
    </servos>

    <commands>
        <axis name="PITCH" failsafe_value="0"/>
        <axis name="ROLL" failsafe_value="0"/>
        <axis name="YAW" failsafe_value="0"/>
        <axis name="THRUST" failsafe_value="0"/>
    </commands>

    <section name="IMU" prefix="IMU_">
        <define name="MAG_X_NEUTRAL" value="-2183"/>
        <define name="MAG_Y_NEUTRAL" value="-727"/>
        <define name="MAG_Z_NEUTRAL" value="-268"/>
        <define name="MAG_X_SENS" value="0.7468911237108754" integer="16"/>
        <define name="MAG_Y_SENS" value="0.7054135259990132" integer="16"/>
        <define name="MAG_Z_SENS" value="0.671669482853358" integer="16"/>

        <!-- TODO: Set correct values -->
        <define name="BODY_TO_IMU_PHI" value="0." unit="deg"/>
        <define name="BODY_TO_IMU_THETA" value="90." unit="deg"/>
        <define name="BODY_TO_IMU_PSI" value="0." unit="deg"/>
    </section>

    <section name="AUTOPILOT">
        <define name="MODE_MANUAL" value="AP_MODE_ATTITUDE_DIRECT"/>
        <define name="MODE_AUTO1" value="AP_MODE_FORWARD"/>
        <define name="MODE_AUTO2" value="AP_MODE_NAV"/>
        <define name="MODE_AUTO3" value="AP_MODE_ATTITUDE_RC_CLIMB"/>
        <define name="MODE_STARTUP" value="AP_MODE_ATTITUDE_DIRECT"/>
    </section>

    <section name="ctrl_eff_scheduling" prefix="FWD_">
        <!-- control effectiveness, scaled by INDI_G_SCALING (1000)-->
        <define name="G1_ROLL"   value="{    0,     0, -10.0,  10.0}"/>
        <define name="G1_PITCH"  value="{-12.0,  12.0,     0,     0}"/>
        <define name="G1_YAW"    value="{-20.0, -20.0,   0.0,   0.0}"/>
        <define name="G1_THRUST" value="{    0,     0,  -0.9,  -0.9}"/>
    </section>

    <section name="STABILIZATION_ATTITUDE" prefix="STABILIZATION_ATTITUDE_">
        <!-- setpoints -->
        <define name="SP_MAX_PHI" value="60." unit="deg"/>
        <define name="SP_MAX_THETA" value="60." unit="deg"/>
        <define name="SP_MAX_R" value="90." unit="deg/s"/>
        <define name="DEADBAND_R" value="250"/>
        <define name="DEADBAND_A" value="250"/>
        <define name="SP_PSI_DELTA_LIMIT" value="90" unit="deg"/>
    </section>

    <section name="STABILIZATION_ATTITUDE_INDI" prefix="STABILIZATION_INDI_">
        <!-- control effectiveness, scaled by INDI_G_SCALING (1000)-->
        <define name="G1_ROLL"   value="{   0,    0,   -10,   10}"/>
        <define name="G1_PITCH"  value="{-3.5,  3.5,      0,     0}"/>
        <define name="G1_YAW"    value="{-2, -2,    0.0,   0.0}"/>
        <define name="G1_THRUST" value="{   0,    0,   -1.5,  -1.5}"/>
        <!--Counter torque effect of spinning up a rotor-->
        <define name="G2" value="{0, 0, 0, 0}"/>

        <!-- reference acceleration for attitude control -->
        <define name="REF_ERR_P" value="107.0"/>
        <define name="REF_ERR_Q" value="58.0"/>
        <define name="REF_ERR_R" value="58.0"/>
        <define name="REF_RATE_P" value="9.0"/>
        <define name="REF_RATE_Q" value="8.8"/>
        <define name="REF_RATE_R" value="8.8"/>

        <!--Maxium yaw rate, to avoid instability-->
        <define name="MAX_R" value="100.0" unit="deg/s"/>

        <define name="ESTIMATION_FILT_CUTOFF" value="4.0"/>
        <define name="FILT_CUTOFF" value="5.0"/>

        <!-- first order actuator dynamics -->
        <define name="ACT_FREQ" value="{30., 30., 23., 23.}"/>
        <define name="ACT_RATE_LIMIT" value="{170, 170, 9600, 9600}"/>
        <define name="ACT_IS_SERVO" value="{1, 1, 0, 0}"/>

        <!-- Adaptive Learning Rate -->
        <define name="USE_ADAPTIVE" value="FALSE"/>
        <define name="ADAPTIVE_MU" value="0.0001"/>
    </section>

    <!-- Gains for horizontal navigation-->
    <section name="GUIDANCE_H" prefix="GUIDANCE_H_">
        <define name="PGAIN" value="100"/>
        <define name="DGAIN" value="100"/>
        <define name="IGAIN" value="0"/>
    </section>

    <!-- Gains for vertical navigation -->
    <section name="GUIDANCE_V" prefix="GUIDANCE_V_">
        <define name="HOVER_KP" value="200"/>
        <define name="HOVER_KD" value="175"/>
        <define name="HOVER_KI" value="72"/>
        <define name="NOMINAL_HOVER_THROTTLE" value ="0.55"/>
        <define name="ADAPT_THROTTLE_ENABLED" value="FALSE"/>
    </section>

    <section name="NAV">
        <define name="NAV_CLIMB_VSPEED" value="1.5"/>
        <define name="NAV_DESCEND_VSPEED" value="-0.8"/>
    </section>

    <!-- <section name="AHRS" prefix="AHRS_"> -->
        <!-- <define name="ICQ_MAG_ID" value="MAG_RM3100_SENDER_ID"/> -->
        <!-- <define name="AHRS_GRAVITY_UPDATE_COORDINATED_TURN" value="TRUE"/> -->
        <!--<define name="AHRS_GPS_SPEED_IN_NEGATIVE_Z_DIRECTION" value="TRUE"/>-->
        <!-- <configure name="AHRS_ALIGNER_LED" value="2"/> -->
        <!-- <define name="FC_MAG_ID" value="MAG_RM3100_SENDER_ID"/> -->
        <!-- <define name="HEADING_UPDATE_GPS_MIN_SPEED" value="0"/> -->
        <!-- <define name="USE_GPS_HEADING" value="TRUE"/> -->
    <!-- </section> -->

    <section name="INS" prefix="INS_">
        <!-- values used if no GPS fix, on 3D fix is update by geo_mag module if loaded -->
        <!-- Delft -->
        <define name="H_X" value="0.3928"/>
        <define name="H_Y" value="-0.0140"/>
        <define name="H_Z" value="0.9195"/>
    </section>

    <section name="MISC">
        <define name="TAILSITTER" value="TRUE"/>
        <define name="RADIO_MODE_2x3" value="TRUE"/>
        <!--The airframe uses (when TRUE) a slightly different axis system for the setpoint, to make both hovering and flying forward intuitive-->
        <define name="USE_EARTH_BOUND_RC_SETPOINT" value="TRUE"/>

        <define name="TRANSITION_MAX_OFFSET" value="-80.0" unit="deg"/>
        <define name="NO_RC_THRUST_LIMIT" value="TRUE"/>
        <define name="COORDINATED_TURN_AIRSPEED" value="18.0"/>

        <define name="BARO_PERIODIC_FREQUENCY" value="50"/>
        <define name="GUIDANCE_H_MAX_BANK" value="60" unit="deg"/>

        <define name="FWD_SIDESLIP_GAIN" value="0.32"/>

        <define name="EFF_SCHED_USE_FUNCTION" value="TRUE"/>

        <define name="ARRIVED_AT_WAYPOINT" value="50.0"/>
