<!DOCTYPE module SYSTEM "module.dtd">

<module name="overactuated_mixing" dir="overactuated_vehicle">
  <doc>
    <description>Overactuated Vehicle Mixing</description>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings NAME="motor_testing">
        <dl_setting var="armed" min="0" max="1" step="1" values="FALSE|TRUE" type="bool" shortname="armed" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="initiate_steps" min="0" max="1" step="1" values="FALSE|TRUE" type="bool" shortname="initiate_steps" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="initiate_sweep" min="0" max="1" step="1" values="FALSE|TRUE" type="bool" shortname="initiate_sweep" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="sweep_duration" min="1" max="60" step="1" type="float" shortname="sweep_duration" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="freq_low" min="0.05" max="1" step="0.05" type="float" shortname="freq_low" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="freq_high" min="0.05" max="2" step="0.05" type="float" shortname="freq_high" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="amplitude" min="0" max="900" step="10" type="float" shortname="amplitude" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="step_duration" min="1" max="10" step="1" type="int32" shortname="step_duration" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="nbr_steps" min="1" max="10" step="1" type="int32_t" shortname="nbr_steps" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="step_perc_high" min="0" max="100" step="10" type="int32_t" shortname="step_perc_high" module="overactuated_vehicle/overactuated_mixing"/>
        <dl_setting var="step_perc_low" min="0" max="100" step="10" type="int32_t" shortname="step_perc_low" module="overactuated_vehicle/overactuated_mixing"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <header>
    <file name="overactuated_mixing.h"/>
  </header>
   
   <init fun="overactuated_mixing_init()"/>
   <periodic fun="overactuated_mixing_run()" autorun="TRUE" freq="500"/>
   <periodic fun="assign_and_send_cmds()" autorun="TRUE" freq="500"/>
  <makefile>
    <file name="overactuated_mixing.c"/>
  </makefile>
</module>
